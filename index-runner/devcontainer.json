{
  "name": "Index Runner Development Environment",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "configureZshAsDefaultShell": true
    }
  },
  "forwardPorts": [
    3000,
    5000,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Web Preview Application Port",
      "onAutoForward": "openPreview"
    }
  },
  "containerEnv": {
    "EXTENSION_RUNNER_ENV": "development"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.autoSave": "afterDelay"
      },
      "extensions": [
        "ms-vscode.live-server"
      ]
    }
  },
  "postCreateCommand": "npm install",
  "remoteUser": "node"
}
